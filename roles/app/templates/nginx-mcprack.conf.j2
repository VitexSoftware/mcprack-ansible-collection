# Managed by Ansible (vitexsoftware.mcprack.app) - do not edit by hand.
server {
    listen 80;
    listen [::]:80;
    server_name {{ mcprack_domain }};

    access_log /var/log/nginx/mcprack-access.log;
    error_log  /var/log/nginx/mcprack-error.log;

    location / {
        proxy_pass http://127.0.0.1:{{ mcprack_bind_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
